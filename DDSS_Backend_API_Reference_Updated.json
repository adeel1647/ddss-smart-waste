    {
      "name": "Authentication",
      "description": "Account registration, login, session, and password reset.",
      "endpoints": [
        {
          "method": "GET",
          "path": "/auth/session",
          "auth": "authenticated",
          "purpose": "Get current session summary",
          "request_example": null,
          "response_example": {
            "authenticated": true,
            "user": {
              "email": "owner@test.com",
              "platform_role": "owner"
            }
          }
        },
        {
          "method": "POST",
          "path": "/auth/login",
          "auth": "public",
          "purpose": "Login and receive token/cookie",
          "request_example": {
            "email": "owner@test.com",
            "password": "Owner123."
          },
          "response_example": {
            "access_token": "<jwt>",
            "token_type": "bearer"
          }
        },
        {
          "method": "POST",
          "path": "/auth/register",
          "auth": "public for bootstrap; restricted for managed role creation",
          "purpose": "Create user. First user becomes global owner/admin depending on backend logic.",
          "request_example": {
            "email": "owner@test.com",
            "password": "Owner123.",
            "display_name": "Owner"
          },
          "response_example": {
            "id": 1,
            "email": "owner@test.com",
            "is_active": true,
            "platform_role": "owner"
          }
        },
        {
          "method": "POST",
          "path": "/auth/forgot-password/request-code",
          "auth": "public",
          "purpose": "Email reset code",
          "request_example": {
            "email": "admin@test.com"
          },
          "response_example": {
            "message": "If an account exists for that email, a verification code has been sent."
          }
        },
        {
          "method": "POST",
          "path": "/auth/forgot-password/verify-code",
          "auth": "public",
          "purpose": "Verify email code and receive reset token",
          "request_example": {
            "email": "admin@test.com",
            "code": "123456"
          },
          "response_example": {
            "message": "Code verified successfully",
            "reset_token": "<jwt>"
          }
        },
        {
          "method": "POST",
          "path": "/auth/forgot-password/reset",
          "auth": "public with reset token",
          "purpose": "Reset password",
          "request_example": {
            "reset_token": "<jwt>",
            "new_password": "NewPass123!",
            "confirm_password": "NewPass123!"
          },
          "response_example": {
            "message": "Password reset successful"
          }
        },
        {
          "method": "POST",
          "path": "/auth/logout",
          "auth": "authenticated",
          "purpose": "Clear auth cookie / end session",
          "request_example": null,
          "response_example": {
            "ok": true
          }
        }
      ]
    },
