{
  "meta": {
    "project": "DDSS Smart Waste Management",
    "version_basis": "Generated from uploaded backend/frontend source on 2026-03-23",
    "base_url": "/api/v1",
    "auth": {
      "methods": [
        "Bearer token",
        "HTTP-only cookie"
      ],
      "headers": [
        "Authorization: Bearer <token>",
        "X-API-Key (optional internal routes)"
      ],
      "login_route": "/auth/login"
    },
    "notes": [
      "Some list endpoints accept organisation_id for scoped filtering.",
      "Global platform roles are owner and admin via users.platform_role.",
      "Scoped roles are owner/admin/manager/operator/viewer via organisation_memberships.",
      "Frontend uses React Query wrappers in frontend/lib/queries.ts for most endpoints."
    ]
  },
  "categories": [
