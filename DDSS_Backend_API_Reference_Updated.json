    {
      "name": "Classification, Forecast & DDSS",
      "description": "ML inference, forecasting, and decision support.",
      "endpoints": [
        {
          "method": "POST",
          "path": "/classify",
          "auth": "authenticated",
          "purpose": "Upload waste image for 6-class classification; optionally store against a bin",
          "request_example": {
            "multipart_form_data": {
              "file": "<image>",
              "bin_id": "LEEDS-CC-001"
            }
          },
          "response_example": {
            "predicted_class": "plastic",
            "confidence": 0.71,
            "top_k": [
              {
                "label": "plastic",
                "confidence": 0.71
              }
            ]
          }
        },
        {
          "method": "POST",
          "path": "/forecast",
          "auth": "authenticated",
          "purpose": "Predict future fill from current features",
          "request_example": {
            "bin_id": "LEEDS-CC-001",
            "fill_level": 72,
            "hour_of_day": 14,
            "day": 2,
            "weekend": 0,
            "growth_rate": 1.6,
            "lags": [
              66,
              69,
              72
            ]
          },
          "response_example": {
            "predicted_fill_6h": 78.4
          }
        },
        {
          "method": "POST",
          "path": "/ddss/process-bin",
          "auth": "authenticated",
          "purpose": "One-bin DDSS style processing pipeline",
          "request_example": {
            "bin_id": "LEEDS-CC-001",
            "fill_level": 72,
