    {
      "name": "Routing & Map",
      "description": "Priority-based route planning, VRP planning, and map projection.",
      "endpoints": [
        {
          "method": "POST",
          "path": "/routing/optimize",
          "auth": "authenticated",
          "purpose": "Optimize a submitted list of points",
          "request_example": {
            "depot_lat": 53.745,
            "depot_lon": -0.335,
            "capacity": 300,
            "strategy": "priority_distance",
            "points": [
              {
                "id": "BIN-001",
                "lat": 53.74,
                "lon": -0.33,
                "priority": 82,
                "demand": 80
              }
            ]
          },
          "response_example": {
            "strategy": "priority_distance",
            "total_distance_km": 13.34,
            "trips": [
              {
                "stops": [
                  "BIN-001"
                ],
                "trip_distance_km": 3.2
              }
            ]
          }
        },
        {
          "method": "POST",
          "path": "/routing/plan-latest",
          "auth": "authenticated",
          "purpose": "Build route plan from latest DDSS run",
          "request_example": {
            "depot_lat": 53.745,
            "depot_lon": -0.335,
            "capacity": 300,
            "strategy": "priority_distance",
            "top_n": 20
          },
          "response_example": {
            "plan_id": 2,
            "decision_run_id": 5,
            "strategy": "priority_distance"
          }
        },
        {
          "method": "POST",
          "path": "/routing/plan-latest-vrp",
          "auth": "authenticated",
          "purpose": "Solve VRP on latest DDSS bins using OR-Tools",
          "request_example": {
            "depot_lat": 53.745,
            "depot_lon": -0.335,
            "capacity": 300,
            "max_vehicles": 4,
            "top_n": 30,
            "priority_weight": 10.0,
            "use_osrm": true
          },
          "response_example": {
            "plan_id": 3,
            "strategy": "vrp",
            "total_distance_km": 11.2,
            "trips": [
              {
                "stops": [
                  {
                    "bin_id": "BIN-001"
